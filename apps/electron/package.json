{
  "name": "@finagent/electron",
  "version": "0.1.0-alpha.1",
  "description": "Windows desktop workspace for public-information enterprise research.",
  "author": "Rapeter",
  "private": true,
  "enterpriseResearchWorkbench": {
    "channel": "alpha"
  },
  "type": "module",
  "main": "./src/main/index.js",
  "scripts": {
    "dev": "vite",
    "build": "vite build && bun run build:preload && bun run build:main",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "test:e2e": "node e2e/business-research.mjs",
    "test:e2e:visible": "node e2e/business-research.mjs --visible",
    "test:e2e:business-research": "node e2e/business-research.mjs",
    "test:e2e:business-research:live": "node e2e/business-research-live.mjs",
    "business-research:live-profile": "node e2e/business-research-live-profile.mjs",
    "test:package-smoke": "node e2e/package-smoke.mjs",
    "test:installer-smoke": "node e2e/installer-smoke.mjs",
    "build:preload": "bun build src/preload/index.ts --outfile src/preload/index.cjs --target node --format cjs --external electron",
    "build:main": "bun build src/main/index.ts --outfile src/main/index.js --bundle --target node --format esm --external electron",
    "build:extension": "bun build ../../.pi/extensions/finagent/index.ts --outfile build/extensions/finagent/index.js --bundle --target node --format esm",
    "package": "bun run build && bun run build:extension && bun run package:builder",
    "package:builder": "electron-builder"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@finagent/core": "workspace:*",
    "@finagent/i18n": "workspace:*",
    "@finagent/pi-extension": "workspace:*",
    "@finagent/shared": "workspace:*",
    "@finagent/ui": "workspace:*",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "4.3.0",
    "electron-builder": "^26.0.0",
    "playwright-core": "^1.62.1",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.6.0",
    "vite": "^6.4.2",
    "electron": "^39.0.0"
  },
  "build": {
    "appId": "com.rapeter.enterpriseresearchworkbench",
    "productName": "Enterprise Research Workbench",
    "directories": {
      "output": "../../dist/electron"
    },
    "electronDist": "node_modules/electron/dist",
    "files": [
      "src/**/*",
      "dist/renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "build/extensions",
        "to": "extensions"
      }
    ],
    "win": {
      "target": ["nsis"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
